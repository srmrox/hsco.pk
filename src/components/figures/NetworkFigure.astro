---
/** Decorative navy illustration: connected nodes with one red node. */
const nodes: [number, number][] = [[120, 110], [260, 90], [360, 160], [180, 230], [320, 260], [110, 290]];
const links: [number, number][] = [[0, 1], [1, 2], [0, 3], [3, 4], [2, 4], [3, 5], [1, 3]];
const id = `net-${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0b3a72" /><stop offset="1" stop-color="#06203f" /></linearGradient></defs>
  <rect width="480" height="360" rx="18" fill={`url(#${id})`} />
  {links.map(([a, b]) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} stroke="rgba(255,255,255,.16)" stroke-width="1.6" />)}
  {nodes.map(([x, y]) => <circle cx={x} cy={y} r="9" fill="rgba(255,255,255,.5)" />)}
  <circle cx="260" cy="90" r="12" fill="var(--color-primary)" />
</svg>
