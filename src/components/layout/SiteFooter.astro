---
<footer class="site-footer">
  <div class="site-footer__main">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="/images/brand/logo-white.png" width="910" height="250" alt={site.name} loading="lazy" />
      <p class="site-footer__motto">{site.motto}</p>
      <p class="site-footer__blurb">{site.footerBlurb}</p>
      <ul class="site-footer__contacts">
        {contacts.map((c) => (
          <li>
            <svg viewBox={icons[c.icon].box} aria-hidden="true"><path d={icons[c.icon].d} /></svg>
            {c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
          </li>
        ))}
      </ul>
    </div>
    <div class="site-footer__form">
      <h2 class="site-footer__heading">Quick Email</h2>
      <QuickEmailForm />
    </div>
  </div>
  <div class="site-footer__bar">
    <div class="site-footer__bar-inner">
      <span>{site.copyright}</span>
      <ul class="site-footer__links">
        {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { font-family: var(--font-ui); color: var(--color-white); }
  .site-footer__main {
    background: var(--color-navy-header);
    max-width: none;
    padding: 50px max(var(--space-5), calc((100% - var(--width-wide)) / 2)) 64px;
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 16px;
  }
  .site-footer__brand { padding-right: 20px; }
  .site-footer__logo { width: 100%; max-width: 310px; height: auto; }
  .site-footer__motto { font-weight: 700; font-size: 17px; line-height: 20px; margin-top: 27px; }
  .site-footer__blurb { font-size: 17px; line-height: 20px; margin-top: 14px; }
  .site-footer__contacts { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 13px; }
  .site-footer__contacts li { display: flex; align-items: center; gap: 16px; font-size: var(--text-base); line-height: 1.6; }
  .site-footer__contacts svg { flex: 0 0 17px; width: 17px; height: 17px; fill: var(--color-white); }
  .site-footer__contacts a { color: inherit; text-decoration: none; }
  .site-footer__contacts a:hover { color: #99a9b5; }
  .site-footer__form { padding-left: 34px; }
  .site-footer__heading { color: var(--color-white); font-family: var(--font-heading); font-size: 22px; font-weight: 700; line-height: 1.2; margin: 6px 0 56px; }

  .site-footer__bar { background: var(--color-primary); padding: 10px var(--space-5); }
  .site-footer__bar-inner {
    max-width: var(--width-wide); margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;
    min-height: 44px; padding-left: 10px;
    font-size: var(--text-base);
  }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: flex; }
  .site-footer__links li + li { border-left: 1px solid rgba(221, 221, 221, .47); }
  .site-footer__links a { display: block; padding: 0 14px; color: var(--color-white); text-decoration: none; transition: color var(--ease); }
  .site-footer__links li:last-child a { padding-right: 0; }
  .site-footer__links a:hover { color: #99a9b5; }

  @media (max-width: 767px) {
    .site-footer__main { grid-template-columns: 1fr; }
    .site-footer__form { padding-left: 0; margin-top: 30px; }
    .site-footer__heading { margin-bottom: 30px; }
    .site-footer__bar-inner { flex-direction: column; align-items: flex-start; padding-left: 0; }
    .site-footer__links li:first-child a { padding-left: 0; }
  }
</style>
