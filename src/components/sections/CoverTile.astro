---
/**
 * CoverTile: rounded photo tile with a strong colour wash and white text (home page values).
 *   tone: red | navy | black
 *   size: lg (wide top tile) | md
 */
interface Props {
  image: string;
  title: string;
  subtitle: string;
  text: string;
  tone?: 'red' | 'navy' | 'black';
  size?: 'md' | 'lg';
}
const { image, title, subtitle, text, tone = 'red', size = 'md' } = Astro.props;
---
<div class:list={['tile', `tile--${tone}`, `tile--${size}`]}>
  <img class="tile__bg" src={image} alt="" loading="lazy" />
  <div class="tile__body">
    <h3 class="tile__title">{title}</h3>
    <p class="tile__subtitle">{subtitle}</p>
    <p class="tile__text">{text}</p>
  </div>
</div>

<style>
  .tile { position: relative; overflow: hidden; border-radius: var(--radius-2xl); padding: var(--space-6); min-height: 240px; display: flex; color: var(--color-white); }
  .tile--lg { padding: var(--space-7); min-height: 200px; align-items: center; }
  .tile__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tile::after { content: ''; position: absolute; inset: 0; }
  .tile--red::after { background: var(--color-primary); opacity: .8; }
  .tile--navy::after { background: var(--color-navy); opacity: .9; }
  .tile--black::after { background: #111111; opacity: .9; }
  .tile__body { position: relative; z-index: 1; }
  .tile__title, .tile__subtitle { color: var(--color-white); font-family: var(--font-heading); font-size: var(--text-h3); line-height: var(--leading-tight); }
  .tile__title { font-weight: 800; }
  .tile__subtitle { font-weight: 300; margin-bottom: 14px; }
  .tile--lg .tile__title, .tile--lg .tile__subtitle { font-size: var(--text-h2); }
  .tile__text { font-size: var(--text-card); line-height: 1.5; }
  .tile--lg .tile__text { font-size: var(--text-base-sm); }
</style>
