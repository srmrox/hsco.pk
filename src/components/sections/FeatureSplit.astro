---
/**
 * FeatureSplit: text on one side, picture on the other.
 *   reverse: picture on the left
 * Slots: default (text) and "figure".
 */
interface Props { reverse?: boolean }
const { reverse = false } = Astro.props;
---
<div class:list={['split', { 'split--reverse': reverse }]}>
  <div class="split__text"><slot /></div>
  <div class="split__figure"><slot name="figure" /></div>
</div>

<style>
  .split { display: grid; grid-template-columns: 1.05fr .95fr; gap: 42px; align-items: center; }
  .split--reverse .split__text { order: 2; }
  .split__figure { border-radius: var(--radius-3xl); overflow: hidden; box-shadow: var(--shadow-figure); }
  .split__figure :global(img), .split__figure :global(svg) { display: block; width: 100%; height: 310px; object-fit: cover; }
  @media (max-width: 820px) {
    .split { grid-template-columns: 1fr; }
    .split--reverse .split__text { order: 0; }
  }
</style>
