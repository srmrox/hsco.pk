---
/**
 * PageHero: the dark navy banner at the top of inner pages.
 *   eyebrow: pill label
 *   title:   page title. Wrap words in <em> to show them in the light-red highlight.
 *   intro:   paragraph under the title
 *   size:    md (44px title) | lg (52px title)
 *   flush:   no bottom padding (use when Stats sit at the bottom edge)
 * Slots: default (buttons, stats) placed under the intro.
 */
import Eyebrow from '../ui/Eyebrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  size?: 'md' | 'lg';
  flush?: boolean;
}
const { eyebrow, title, intro, size = 'md', flush = false } = Astro.props;
---
<section class:list={['hero', `hero--${size}`, { 'hero--flush': flush }]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h1 class="hero__title" set:html={title} />
  {intro && <p class="hero__intro" set:html={intro} />}
  <slot />
</section>

<style>
  .hero {
    background: var(--texture-dots-light), var(--gradient-hero);
    text-align: center;
    padding: 80px var(--gutter) 72px;
  }
  .hero--flush { padding-bottom: 0; }
  .hero__title {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: var(--tracking-tight);
    max-width: 820px;
    margin: 22px auto 0;
  }
  .hero--lg .hero__title { font-size: var(--text-h1-lg); }
  .hero__title :global(em) { color: var(--color-accent-light); font-style: normal; }
  .hero__intro {
    color: var(--color-on-dark);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 660px;
    margin: 18px auto 0;
  }
  .hero :global(.btn-group) { justify-content: center; margin-top: var(--space-7); }
  @media (max-width: 820px) {
    .hero__title, .hero--lg .hero__title { font-size: var(--text-h1-sm); }
    .hero__intro { font-size: var(--text-base); }
  }
</style>
