---
/** Insight / article card: red top strip, category, title, meta line. */
interface Props { category: string; title: string; meta: string; href?: string }
const { category, title, meta, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag class="article" href={href}>
  <div class="article__strip"></div>
  <div class="article__body">
    <div class="article__cat">{category}</div>
    <h3 class="article__title">{title}</h3>
    <div class="article__meta">{meta}</div>
  </div>
</Tag>

<style>
  .article { display: flex; flex-direction: column; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--color-white); text-decoration: none; }
  .article__strip { height: 6px; background: var(--color-primary); }
  .article__body { padding: 20px; }
  .article__cat { color: var(--color-primary); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .article__title { font-size: var(--text-h4); font-weight: 700; line-height: 1.3; margin: 8px 0; }
  .article__meta { color: var(--color-text-subtle); font-size: var(--text-meta); }
</style>
