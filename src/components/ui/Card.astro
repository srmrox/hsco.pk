---
/**
 * Card: white box with a red top edge. The standard card on the site.
 *   href:   makes the whole card a link
 *   size:   md (values, group companies) | sm (compact: "when to engage us", "why work here")
 *   accent: top (red top border, default) | none
 *   number: optional "01" label above the title
 *   hover:  lift on hover (default true for md)
 */
interface Props {
  title: string;
  text?: string;
  href?: string;
  size?: 'sm' | 'md';
  accent?: 'top' | 'none';
  number?: string;
  hover?: boolean;
}
const { title, text, href, size = 'md', accent = 'top', number, hover = size === 'md' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={['card', `card--${size}`, `card--accent-${accent}`, { 'card--hover': hover, 'card--link': href }]}>
  {number && <div class="card__number">{number}</div>}
  <h3 class="card__title" set:html={title} />
  {text && <p class="card__text" set:html={text} />}
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    transition: box-shadow var(--ease), transform var(--ease);
  }
  .card--accent-top { border-top: var(--accent-bar); }
  .card--sm { border-radius: var(--radius-lg); padding: 18px; box-shadow: none; }
  .card--hover:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .card--link:hover { transform: translateY(-3px); }

  .card__number {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-card);
  }
  .card__title {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .card__number + .card__title { margin-top: 4px; }
  .card--sm .card__title { font-size: var(--text-base); margin-bottom: 6px; }
  .card__text {
    color: var(--color-text-muted);
    font-size: 14.5px;
    line-height: var(--leading-normal);
    margin: 0;
  }
  .card--sm .card__text { font-size: var(--text-card); line-height: 1.55; }
</style>
