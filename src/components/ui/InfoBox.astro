---
/** Plain bordered box with a title (office addresses). */
interface Props { title: string }
const { title } = Astro.props;
---
<div class="info">
  <h3 class="info__title">{title}</h3>
  <div class="info__body"><slot /></div>
</div>

<style>
  .info { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); background: var(--color-white); }
  .info + .info { margin-top: var(--space-4); }
  .info__title { font-size: 20px; font-weight: 700; margin: 0 0 8px; }
  .info__body { color: var(--color-text); font-size: var(--text-base-sm); line-height: 1.7; }
  .info__body :global(a) { color: inherit; text-decoration: none; }
  .info__body :global(a:hover) { color: var(--color-primary); }
</style>
