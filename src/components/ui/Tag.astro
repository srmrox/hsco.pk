---
/**
 * Small rounded label.
 *   variant: red (filled red tint) | outline (grey border; filter chips)
 */
interface Props { variant?: 'red' | 'outline' }
const { variant = 'red' } = Astro.props;
---
<span class:list={['tag', `tag--${variant}`]}><slot /></span>

<style>
  .tag { display: inline-block; border-radius: var(--radius-pill); }
  .tag--red {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--color-primary);
    background: var(--color-primary-soft);
    padding: 4px 11px;
  }
  .tag--outline {
    border: 1px solid var(--color-border-strong);
    padding: 6px 14px;
    font-size: var(--text-meta);
    color: var(--color-navy);
    background: var(--color-white);
    margin: 0 8px 8px 0;
  }
</style>
