---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import InfoBox from '../components/ui/InfoBox.astro';
---
<BaseLayout title="Contact" description="Contact Hina Shahrukh & Co. in Islamabad or London.">
  <PageHero eyebrow="Contact" title="Let’s talk"
    intro="Tell us a little about your business and what you are trying to solve. We will get you to the right partner, not a call centre." />

  <Section width="max">
    <div class="contact">
      <div>
        <InfoBox title="Islamabad">
          Office #1, 2nd Floor, Al-Hameed Plaza,<br />G-11 Markaz, Islamabad<br />
          <a href="mailto:mail@hsco.pk">mail@hsco.pk</a><br />
          <a href="tel:+923018510470">+92 301 8510470</a>
        </InfoBox>
        <InfoBox title="London (UK)">
          27 Old Gloucester Street<br />London WC1N 3AX<br />
          <a href="mailto:mail@hsco.uk">mail@hsco.uk</a>
        </InfoBox>
      </div>
      <div>
        <!-- Same placeholder as the live site. Replace with a real form when ready. -->
        <div class="placeholder">Contact form goes here (WPForms). Fields: name, email, company, service of interest, message. Routes to mail@hsco.pk.</div>
        <p class="small">Anything you share is treated in confidence. Client engagements are governed by separate engagement letters and, where needed, non-disclosure agreements.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 40fr 60fr; gap: 2em; }
  .placeholder { border: 2px dashed var(--color-border-strong); border-radius: var(--radius-lg); padding: var(--space-8); background: #f8fafc; color: #64748b; text-align: center; font-size: var(--text-base-sm); }
  .small { color: var(--color-heading-sub); margin-top: var(--space-4); font-size: var(--text-card); }
  @media (max-width: 781px) { .contact { grid-template-columns: 1fr; } }
</style>
